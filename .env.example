# =============================================================================
# LAB3 Godot x Cardano Testnet — environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (it is gitignored).
# =============================================================================

# Cardano test network: preprod (default) or preview
NETWORK=preprod

# Port for the local signing bridge
PORT=8787

# Provider used by the signing bridge:
#   koios     -> public Koios API, no key required (default)
#   blockfrost-> requires BLOCKFROST_API_KEY below
PROVIDER=koios

# Blockfrost project id (only needed if PROVIDER=blockfrost)
# BLOCKFROST_API_KEY=

# 15- or 24-word testnet wallet mnemonic (space or comma separated).
# Generate one safely with:  npm run key
# Fund it with test ADA via: npm run fund   (or the official Cardano faucet)
MNEMONIC=

# Optional: PostgreSQL URL for off-chain player progression storage (e.g. Neon).
# Leave empty to run without cloud persistence.
DATABASE_URL=

# Optional override for the bridge URL the Godot client connects to.
# LAB3_BRIDGE_URL=http://127.0.0.1:8787

# Google OAuth (server-only; never put the secret in Godot or frontend files)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://lab3-godot-cardano-bridge.vercel.app/api/auth/callback/google
# GOOGLE_FRONTEND_URL=https://vercel-game-alpha.vercel.app
